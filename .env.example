# =========================================================================
# DSK TASKMARKETER - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# 1. AI STUDIO & CORE RUNTIME CONFIGURATION
# -------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, email redirect callbacks, and webhook endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# -------------------------------------------------------------------------
# Required for PostgreSQL persistence, user tables, and Supabase Auth.
SUPABASE_URL=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SERVER-SIDE ONLY: NEVER expose SERVICE_ROLE_KEY to frontend or browser
SUPABASE_SERVICE_ROLE_KEY=""

# -------------------------------------------------------------------------
# 3. PRODUCTION ADMINISTRATOR CREDENTIALS (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# Used on the very first administrator setup to initialize credentials.
# On first run, the system hashes INITIAL_ADMIN_PASSWORD with scrypt + salt
# and permanently saves it to Supabase (platform_settings & profiles).
# After setup, the stored Supabase hash is the permanent source of truth.
INITIAL_ADMIN_EMAIL="dsktaskmarketer@gmail.com"
INITIAL_ADMIN_PASSWORD=""
ADMIN_SETUP_COMPLETED="true"

# =========================================================================
# 4. MULTI-PROVIDER EMAIL OTP DELIVERY SYSTEM (CASCADE FALLBACK)
# =========================================================================
# The backend uses an automatic sequential HTTP API cascade for OTP emails:
#
#   ┌─────────────────────────────────────────────────────────────┐
#   │ PRIORITY 1 (MAIN)      : Brevo (Sendinblue) HTTP API        │
#   │                          POST https://api.brevo.com/v3/smtp/email
#   │                          Header: api-key: BREVO_API_KEY     │
#   │                          ↳ If SUCCESS: Stops immediately.   │
#   │                          ↳ If FAILS: Falls back to Mailjet. │
#   ├─────────────────────────────────────────────────────────────┤
#   │ PRIORITY 2 (BACKUP 1)  : Mailjet Transactional API          │
#   │                          POST https://api.mailjet.com/v3.1/send
#   │                          Header: Basic Auth (Key:Secret)    │
#   │                          ↳ If SUCCESS: Stops immediately.   │
#   │                          ↳ If FAILS: Falls back to Resend.  │
#   ├─────────────────────────────────────────────────────────────┤
#   │ PRIORITY 3 (BACKUP 2)  : Resend HTTP API                    │
#   │                          POST https://api.resend.com/emails │
#   │                          Header: Bearer RESEND_API_KEY      │
#   │                          ↳ If SUCCESS: Stops immediately.   │
#   │                          ↳ If FAILS: Returns failure error. │
#   └─────────────────────────────────────────────────────────────┘
#
# KEY BEHAVIOR & RULES:
# - ZERO DUPLICATES: Only ONE provider sends the email. Execution halts on first success.
# - SINGLE OTP: The exact same 6-digit OTP code is reused across all fallback attempts.
# - SERVER-SIDE ONLY: NEVER use VITE_ prefix. These keys must never reach client bundles.
# - SENDER IDENTITY: All providers use SENDER_EMAIL with sender name "DSK TaskMarketer".
# -------------------------------------------------------------------------

# --- PROVIDER 1: BREVO (MAIN / PRIORITY 1) ---
# Sign up / Log in at: https://app.brevo.com
# 1. Go to: Settings -> SMTP & API -> API Keys
# 2. Click "Generate a new API key", name it (e.g. "DSK Production"), and copy the key.
# 3. Verify your sender email domain or single sender under Senders & IP.
BREVO_API_KEY=""

# --- PROVIDER 2: MAILJET (BACKUP 1 / PRIORITY 2) ---
# Sign up / Log in at: https://app.mailjet.com
# 1. Go to: Account Settings -> REST API Keys -> API Key Management
# 2. Copy the "API Key" (Public) into MAILJET_API_KEY.
# 3. Copy the "Secret Key" (Private) into MAILJET_SECRET_KEY.
# 4. Verify your sender email under "Senders & Domains".
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""

# --- PROVIDER 3: RESEND (BACKUP 2 / PRIORITY 3) ---
# Sign up / Log in at: https://resend.com
# 1. Go to: API Keys -> Create API Key (Full Access or Sending Access).
# 2. Copy the key (starts with "re_") into RESEND_API_KEY.
# 3. Verify your sending domain or use your registered team email.
RESEND_API_KEY=""

# --- VERIFIED SENDER ADDRESS ---
# Must be a verified sender/domain in your Brevo, Mailjet, and Resend accounts.
# Format: either raw email (user@domain.com) or named ("DSK TaskMarketer <user@domain.com>")
SENDER_EMAIL="dsktaskmarketer@gmail.com"

# -------------------------------------------------------------------------
# 5. SERVER RUNTIME & DEPLOYMENT CONFIGURATION
# -------------------------------------------------------------------------
# Port 3000 is required for AI Studio nginx proxy routing.
# In production platforms (Cloud Run / Render), PORT is dynamically mapped.
PORT=3000
NODE_ENV="production"
